---
// Composes the single-page site. Also rendered by `en/index.astro`;
// every component reads `Astro.currentLocale`, so the same tree serves both locales.
import Nav from "../components/Nav.astro";
import About from "../components/sections/About.astro";
import Contact from "../components/sections/Contact.astro";
import Footer from "../components/sections/Footer.astro";
import Gallery from "../components/sections/Gallery.astro";
import Hero from "../components/sections/Hero.astro";
import Merch from "../components/sections/Merch.astro";
import Shows from "../components/sections/Shows.astro";
import Videos from "../components/sections/Videos.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <header>
    <Nav />
  </header>
  <main>
    <Hero />
    <About />
    <Shows />
    <Videos />
    <Gallery />
    <Merch />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
